+
+/** Preserve table wrappers while enforcing the host's no-new-image setting. */
+const filterPastedTableImages = (
+    slice: Slice,
+    inlineImages?: InlineImages
+): Slice => {
+    if (!containsPastedTable(slice) || !inlineImages || inlineImages.upload) {
+        return slice;
+    }
+    const withoutImages = (fragment: Fragment): Fragment => {
+        const children: Node[] = [];
+        // eslint-disable-next-line unicorn/no-array-for-each
+        fragment.forEach((child) => {
+            if (child.type.name !== 'image') {
+                children.push(
+                    child.isLeaf ? child : child.copy(withoutImages(child.content))
+                );
+            }
+        });
+        return Fragment.fromArray(children);
+    };
+    return new Slice(withoutImages(slice.content), slice.openStart, slice.openEnd);
+};
