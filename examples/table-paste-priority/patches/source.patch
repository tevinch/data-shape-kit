+
+/** Detect table, row and cell slices before content-specific paste shortcuts. */
+export const containsPastedTable = (slice: Slice): boolean => {
+    let found = false;
+    slice.content.descendants((node) => {
+        if (node.type.spec.tableRole) {
+            found = true;
+        }
+        return !found;
+    });
+    return found;
+};
