+import { tick } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	mode: ['client', 'hydrate'],
+	async test({ assert, target, logs }) {
+		for (let i = 0; i < 3; i++) {
+			logs.length = 0;
+			target.querySelector('button[data-toggle]')?.click();
+			await tick();
+			assert.equal(target.querySelector('p')?.textContent, '1');
+			assert.deepEqual(logs, [0, 1]);
+
+			target.querySelector('button[data-increment]')?.click();
+			await tick();
+			assert.equal(target.querySelector('p')?.textContent, '2');
+			assert.deepEqual(logs, [0, 1, 2]);
+
+			target.querySelector('button[data-reset]')?.click();
+			await tick();
+			assert.equal(target.querySelector('p')?.textContent, '1');
+			assert.deepEqual(logs, [0, 1, 2, 0, 1]);
+
+			target.querySelector('button[data-toggle]')?.click();
+			await tick();
+			assert.equal(target.querySelector('p'), null);
+		}
+	}
+});
